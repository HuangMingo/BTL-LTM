# TCP server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
MAX_CLIENTS=100
IDLE_TIMEOUT_SECONDS=90

# JavaFX client runs natively on the host
CLIENT_TARGET_HOST=localhost
CLIENT_TARGET_PORT=5000

# PostgreSQL (development defaults only; replace before deployment)
POSTGRES_DB=LTM_db
POSTGRES_USER=tcp_chat
POSTGRES_PASSWORD=tcp_chat_dev

# Optional: docker compose --profile tools up pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-for-local-use

LOG_LEVEL=INFO
